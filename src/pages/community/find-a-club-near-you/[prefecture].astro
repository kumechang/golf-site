---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { prefectures, getPrefectureBySlug, coursesCheckedAt } from '../../../data/prefectures';
import { getOsmCoursesBySlug } from '../../../data/osm-course-examples';
import MunicipalPlaces from '../../../components/MunicipalPlaces.astro';
import VideoGallery from '../../../components/VideoGallery.astro';
import { placeVideos } from '../../../data/place-videos';
import { detailedFacilityKeys, getPlacesBySlug, normKey } from '../../../data/places';
import { locationKey } from '../../../data/place-keys.mjs';
import { loadPrefEvents } from '../../../data/pref-events';

export async function getStaticPaths() {
  return prefectures.map((pref) => ({
    params: { prefecture: pref.slug },
    props: { pref },
  }));
}

const { pref } = Astro.props as { pref: (typeof prefectures)[number] };

const eventPage = loadPrefEvents().get(pref.name);

const title = `${pref.name}でグラウンドゴルフを楽しめるクラブ・コースの探し方`;
const description = `${pref.name}でグラウンドゴルフ（グランドゴルフ）のクラブやコースを探している方向けに、都道府県協会の窓口情報と、JGGA（日本グラウンド・ゴルフ協会）認定コースの情報に加え、市区町村の案内にグラウンドゴルフの記載がある施設へのリンクをご紹介します。`;

const breadcrumbItems = [
  { name: 'トップ', href: '/' },
  { name: '大会・コミュニティ情報', href: '/community/' },
  { name: '都道府県別クラブ・コースの探し方', href: '/community/find-a-club-near-you/' },
  { name: pref.name, href: Astro.url.pathname },
];

const nearbyPrefs = pref.nearbySlugs
  .map((slug) => getPrefectureBySlug(slug))
  .filter((p): p is NonNullable<typeof p> => Boolean(p && p.courseCount > 0));

// 市区町村のページから住所・電話番号を取った施設は、上の節に載せているので、この節からは外す（同じ施設の重複を避ける）。
const detailed = detailedFacilityKeys(pref.slug);
const osmCourses = getOsmCoursesBySlug(pref.slug).filter((c) => {
  // 住所と電話番号が（表記の違いを除いて）同じなら、名前が違っても同じ場所として外す
  const loc = locationKey(c.address, c.phone);
  if (loc && detailed.locations.has(loc)) return false;
  for (const key of detailed.names) {
    const [muni, name] = key.split('|');
    if (c.address.includes(muni) && normKey(c.name) === name) return false;
  }
  return true;
});

// 施設の動画は、その施設のカードが載っているなら、カードの中に載せる。載っていないものだけ、動画の節に載せる。
const municipalFacilityNames = getPlacesBySlug(pref.slug).groups.flatMap((g) => g.facilities.map((f) => f.name ?? ''));
const allVideos = placeVideos[pref.slug] ?? [];
const inMunicipal = allVideos.filter((v) => v.facility && municipalFacilityNames.some((n) => n.includes(v.facility!)));
const inVerified = allVideos.filter((v) => v.facility && !inMunicipal.includes(v) && osmCourses.some((c) => c.name.includes(v.facility!)));
const galleryVideos = allVideos.filter((v) => !inMunicipal.includes(v) && !inVerified.includes(v));
---

<BaseLayout title={title} description={description}>
  <Breadcrumb items={breadcrumbItems} />

  <article class="mx-auto max-w-3xl px-4 pb-20 pt-6">
    <header>
      <a
        href="/community/"
        class="inline-block rounded-full bg-indigo-50 px-3 py-1 text-xs font-bold text-indigo-700"
      >
        大会・コミュニティ情報
      </a>
      <h1 class="mt-3 text-3xl font-bold leading-snug text-slate-900 sm:text-4xl">{title}</h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">{description}</p>
    </header>
    <nav aria-label="このページの内容" class="mt-5">
      <ul role="list" class="flex flex-wrap gap-2">
        {[
          { href: '#association', text: `${pref.name}グラウンド・ゴルフ協会の窓口` },
          { href: '#jgga-courses', text: 'JGGA認定コース' },
          { href: '#municipal-places', text: '市区町村の案内にある施設' },
          ...(eventPage?.hasPage ? [{ href: `/community/events/${pref.slug}/`, text: `${pref.name}のグラウンドゴルフ予定表` }] : []),
        ].map((b) => (
          <li>
            <a href={b.href} class="tap-target inline-flex items-center rounded-full border-2 border-green-800 bg-white px-4 text-base font-bold text-green-900 hover:bg-green-50">{b.text}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="prose-article mt-8 text-slate-800">
      <h2 id="association">{pref.name}グラウンド・ゴルフ協会の窓口</h2>
      {pref.association.url ? (
        <p>
          {pref.name}には、グラウンドゴルフに関する問い合わせ先として次の窓口があります。
          {pref.association.urlLabel ?? '公式サイト'}は
          <a href={pref.association.url} rel="nofollow noopener" target="_blank" data-gg-outbound="association">
            こちら
          </a>
          （新しいタブで開きます）からご確認いただけます。
          {pref.association.note && <>（{pref.association.note}）</>}
        </p>
      ) : (
        <p>
          {pref.name}のグラウンド・ゴルフ協会について、独自に運営している公式サイトは現時点で確認できていません。
          {pref.association.note && <>{pref.association.note}。</>}
          お住まいの市区町村の「スポーツ振興課」「社会福祉協議会」「スポーツ協会（体育協会）」にお問い合わせいただくと、地域のクラブや窓口を紹介してもらえることが多いです。詳しくは
          <a href="/community/find-a-club-near-you/">クラブ・コースの探し方</a>
          の記事もあわせてご覧ください。
        </p>
      )}

      <h2 id="jgga-courses">{pref.name}のJGGA認定コースについて</h2>
      {pref.courseCount > 0 ? (
        <p>
          公益社団法人日本グラウンド・ゴルフ協会（JGGA）公式サイトの「認定コース」ページには、{pref.name}内の認定コースが掲載されています（{coursesCheckedAt}時点で{pref.courseCount}件確認）。施設名・所在地・電話番号など詳しい情報は、JGGA公式サイトでご確認ください。
        </p>
      ) : (
        <p>
          現時点で、{pref.name}内のJGGA認定コースとして公式サイトに掲載されている施設は確認できていません（{coursesCheckedAt}確認）。認定コース以外にも、公共の公園や自治体の運動施設でグラウンドゴルフを楽しめる場合がありますので、お住まいの市区町村のスポーツ振興課や社会福祉協議会にお問い合わせください。
        </p>
      )}
      {pref.sourceUrl && (
        <p>
          <a href={pref.sourceUrl} rel="nofollow noopener" target="_blank" data-gg-outbound="jgga-courses">
            JGGA公式サイトで{pref.name}の認定コース情報を見る
          </a>
          （新しいタブで開きます）
        </p>
      )}
      {pref.courseCount === 0 && nearbyPrefs.length > 0 && (
        <>
          <h3>近隣の都道府県のJGGA認定コース</h3>
          <p>
            {pref.name}に隣接する都道府県には、JGGA認定コースがあります。お住まいの地域によっては、こちらも選択肢になるかもしれません。
          </p>
          <ul>
            {nearbyPrefs.map((np) => (
              <li>
                <a href={`/community/find-a-club-near-you/${np.slug}/`}>{np.name}（{np.courseCount}件）</a>
              </li>
            ))}
          </ul>
        </>
      )}

    </div>

    {/* 施設を探す節は、本文用の余白・リストの記号の設定（prose-article）を受けないよう、本文の外に置く */}
    <MunicipalPlaces prefName={pref.name} slug={pref.slug} verified={osmCourses} videos={inMunicipal} verifiedVideos={inVerified} />

    <div class="prose-article text-slate-800">

      {galleryVideos.length > 0 && (
        <VideoGallery
          videos={galleryVideos}
          heading={`${pref.name}の施設を紹介する動画`}
          intro="施設や自治体、地域の情報サイト、愛好者の方などが公開している動画です。題名や紹介の言葉は投稿者によるもので、動画の内容は、当サイトでは確認していません。公開された時期のもので、いまの利用方法や料金と異なる場合があります。利用の前に、施設や市区町村にご確認ください。"
          id="facility-videos"
        />
      )}

      <h2>あわせて読みたい</h2>
      <ul>
        <li><a href="/community/find-a-club-near-you/">都道府県別グラウンドゴルフクラブ・コースの探し方（一覧に戻る）</a></li>
        <li><a href="/start/find-a-class/">体験教室の探し方</a></li>
        <li><a href="/gear/how-to-choose-a-club/">クラブの選び方（初心者向け）</a></li>
      </ul>
    </div>
  </article>
</BaseLayout>
