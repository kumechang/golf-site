---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/categories';
import heroCourseScene from '../assets/illustrations/hero-course-scene.jpg';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const latestArticles = allArticles.slice(0, 6);
// 収益コアである比較記事（クラブセット比較・ギフトガイド）は、
// どちらか一方だけが偶然表示されることのないよう、すべてトップページに露出させる。
const featuredComparisons = allArticles.filter((a) => a.data.articleType === 'comparison');

const golfSwitchArticle = allArticles.find((a) => a.id === 'from-golf-to-ground-golf');

function countByCategory(slug: string) {
  return allArticles.filter((a) => a.data.category === slug).length;
}

const pageDescription =
  'グラウンドゴルフをこれから始める方、親や上司世代のために道具を選びたい方へ。ルール・始め方・道具選びをやさしく解説する入門情報サイトです。';
---

<BaseLayout
  title="グラウンドゴルフとは？初心者向け入門ガイド"
  description={pageDescription}
>
  <Fragment slot="full-bleed">
    <section class="relative isolate overflow-hidden bg-green-800 text-white">
      <div class="lg:absolute lg:inset-y-0 lg:right-0 lg:w-[min(62%,56rem)]">
        <Image
          src={heroCourseScene}
          alt="グラウンドゴルフのホールポストに向かってクラブを構える男性のイラスト"
          width={1400}
          height={782}
          widths={[640, 960, 1400]}
          sizes="(min-width: 1024px) 56rem, 100vw"
          loading="eager"
          class="hero-art aspect-[16/9] w-full object-cover lg:aspect-auto lg:h-full lg:object-[72%_35%]"
        />
      </div>
      <div class="relative mx-auto max-w-5xl px-4 pb-14 lg:flex lg:min-h-[34rem] lg:items-center lg:py-20">
        <div class="-mt-6 max-w-xl lg:mt-0">
          <h1 class="[word-break:auto-phrase] [text-wrap:balance]">
            <span class="block text-3xl font-bold leading-snug sm:text-4xl lg:text-5xl lg:leading-tight">
              親の道具選びも、<wbr />自分の新しい趣味探しも。
            </span>
            <span class="mt-3 block text-lg font-semibold text-green-100 sm:text-xl">
              グラウンドゴルフ入門ナビ
            </span>
          </h1>
          <p class="mt-6 text-base leading-relaxed text-white/90 [word-break:auto-phrase] [text-wrap:pretty] sm:text-lg">
            ルールの基本から、体験教室の探し方、失敗しない道具の選び方まで。
            競技経験がなくても迷わないよう、<span class="whitespace-nowrap">一つずつ</span>やさしく解説します。
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href="/guide/what-is-ground-golf/"
              class="tap-target inline-flex items-center rounded-lg bg-white px-6 py-3.5 text-base font-bold text-green-900 transition-colors hover:bg-green-50"
            >
              グラウンドゴルフとは？から読む
            </a>
            <a
              href="/gear/"
              class="tap-target inline-flex items-center text-base font-semibold text-white underline decoration-white/60 underline-offset-4 hover:decoration-white"
            >
              道具選びを見る
            </a>
          </div>
        </div>
      </div>
    </section>
  </Fragment>

  <section class="mx-auto max-w-5xl px-4 py-14">
    <h2 class="text-2xl font-bold text-slate-900">カテゴリから探す</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      {
        categories.map((cat) => (
          <CategoryCard category={cat} articleCount={countByCategory(cat.slug)} />
        ))
      }
    </div>
  </section>

  {golfSwitchArticle && (
    <section class="mx-auto max-w-5xl px-4">
      <div class="flex flex-col gap-4 border-y border-slate-200 py-8 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
        <div class="max-w-xl">
          <h2 class="text-xl font-bold text-slate-900">ゴルフの経験がある方へ</h2>
          <p class="mt-2 text-base leading-relaxed text-slate-700 [word-break:auto-phrase]">
            ゴルフとグラウンドゴルフは、似ているようで別のスポーツです。
            <span class="whitespace-nowrap">違いのほか、</span>続ける・移る・両方といった選び方も整理しました。
          </p>
        </div>
        <a
          href={`/${golfSwitchArticle.data.category}/${golfSwitchArticle.id}/`}
          class="tap-target inline-flex shrink-0 items-center self-start rounded-lg border border-green-700 px-5 py-3 text-base font-bold text-green-800 transition-colors hover:bg-green-50 sm:self-auto"
        >
          ゴルフとの違いと両立の考え方を読む
        </a>
      </div>
    </section>
  )}

  {featuredComparisons.length > 0 && (
    <section class="bg-amber-50">
      <div class="mx-auto max-w-5xl px-4 py-14">
        <p class="text-sm font-bold text-amber-700">道具選びに迷ったら</p>
        <div class="mt-4 grid gap-5 sm:grid-cols-2">
          {featuredComparisons.map((article) => (
            <div class="rounded-2xl border border-amber-200 bg-white p-6 shadow-sm sm:p-8">
              <h2 class="text-xl font-bold text-slate-900">{article.data.title}</h2>
              <p class="mt-3 text-base leading-relaxed text-slate-600">{article.data.description}</p>
              <a
                href={`/${article.data.category}/${article.id}/`}
                class="tap-target mt-5 inline-flex items-center rounded-lg bg-green-700 px-5 py-3 text-base font-bold text-white transition-colors hover:bg-green-800"
              >
                比較記事を読む
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-5xl px-4 py-14">
    <div class="flex items-center justify-between">
      <h2 class="text-2xl font-bold text-slate-900">新着記事</h2>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        latestArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={`/${article.data.category}/${article.id}/`}
            category={article.data.category}
            pubDate={article.data.pubDate}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20">
    <div class="rounded-2xl bg-sky-50 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-slate-900">このサイトについて</h2>
      <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-700">
        本サイトは、グラウンドゴルフの競技経験がない方でも迷わず読めることを目指した個人運営の情報サイトです。
        記事内容の考え方や運営者情報は
        <a href="/about/" class="font-semibold text-green-700 underline underline-offset-2">サイトについて／運営者情報</a>
        のページで詳しくご紹介しています。
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* 画像を背景の緑へなじませる。スマホは下端、PCは左端を溶かす */
  .hero-art {
    mask-image: linear-gradient(to bottom, #000 80%, transparent);
  }
  @media (min-width: 1024px) {
    .hero-art {
      mask-image: linear-gradient(to right, transparent, #000 40%);
    }
  }
</style>
