---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { categories, getCategory } from '../../data/categories';
import { categoryImages } from '../../data/category-images';

export async function getStaticPaths() {
  return categories.map((cat) => ({ params: { category: cat.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category!)!;
const image = categoryImages[cat.slug];

const articles = (await getCollection('articles', (a) => a.data.category === cat.slug)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout title={cat.metaTitle} description={cat.metaDescription}>
  <Breadcrumb items={[{ name: 'トップ', href: '/' }, { name: cat.name, href: `/${cat.slug}/` }]} />

  <header class="mx-auto max-w-5xl px-4 pt-8">
    <div class:list={[image ? 'grid gap-6 sm:grid-cols-[1fr_auto] sm:items-center' : '']}>
      <div>
        <span class:list={['inline-block rounded-full px-3 py-1 text-xs font-bold', cat.accent.bg, cat.accent.text]}>
          カテゴリ
        </span>
        <h1 class="mt-3 text-3xl font-bold text-slate-900 sm:text-4xl">{cat.heading ?? cat.name}</h1>
        <p class="mt-3 max-w-2xl text-base leading-relaxed text-slate-600">{cat.description}</p>
      </div>
      {image && (
        <Image
          src={image.src}
          alt={image.alt}
          width={220}
          height={220}
          class="hidden h-40 w-40 rounded-2xl object-cover shadow-sm sm:block"
        />
      )}
    </div>
  </header>

  <section class="mx-auto max-w-5xl px-4 py-10">
    {(cat.slug === 'guide' || cat.slug === 'start') && (
      <div class="mb-6 rounded-2xl border border-green-200 bg-green-50 p-5">
        <p class="text-lg font-bold text-green-900">近くで始めたい方へ</p>
        <div class="mt-3 flex flex-col gap-3 sm:flex-row">
          <a href="/start/find-a-class/" class="inline-flex min-h-[3rem] items-center justify-center rounded-lg bg-green-800 px-5 py-2 text-lg font-bold text-white hover:bg-green-900">体験教室の探し方を読む</a>
          <a href="/start/find-a-class/#pref-list" class="inline-flex min-h-[3rem] items-center justify-center rounded-lg border-2 border-green-800 bg-white px-5 py-2 text-lg font-bold text-green-900 hover:bg-green-50">県の名前から探す</a>
        </div>
      </div>
    )}
    {cat.slug === 'guide' && (
      <nav aria-label="あなたに近いものを選んでください" class="mb-6">
        <p class="text-lg font-bold text-slate-900">あなたに近いものを選んでください</p>
        <ul role="list" class="mt-2 flex flex-wrap gap-2">
          <li><a href="/guide/retirement-hobby-comparison/" class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">定年後の趣味を探している</a></li>
          <li><a href="/guide/from-golf-to-ground-golf/" class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">ゴルフの経験がある</a></li>
          <li><a href="/guide/gentle-exercise-comparison/" class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">膝や腰が気になる</a></li>
        </ul>
      </nav>
    )}
    {cat.slug === 'community' && (
      <a
        href="/community/events/"
        class="mb-6 block rounded-2xl border border-indigo-200 bg-indigo-50 p-5 hover:bg-indigo-100"
      >
        <span class="block text-lg font-bold text-indigo-900">地域別の大会予定表（一部の地域）</span>
        <span class="mt-1 block text-base leading-relaxed text-slate-700">今後の大会を、日程と開催地で見る。載っているのは一部の地域だけです。</span>
      </a>
    )}
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        articles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            href={`/${cat.slug}/${article.id}/`}
            category={article.data.category}
            pubDate={article.data.pubDate}
          />
        ))
      }
    </div>
    {articles.length === 0 && (
      <p class="text-slate-500">このカテゴリの記事は準備中です。</p>
    )}
  </section>
</BaseLayout>
