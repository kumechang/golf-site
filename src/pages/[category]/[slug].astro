---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ProductComparisonList from '../../components/ProductComparisonList.astro';
import ProductComparisonTable from '../../components/ProductComparisonTable.astro';
import ShoeCompare from '../../components/ShoeCompare.astro';
import { getProductsByIds } from '../../data/products';
import { articleImages } from '../../data/article-images';
import PrefectureLinks from '../../components/PrefectureLinks.astro';
import { articleGuides } from '../../data/article-guides';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { category: article.data.category, slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const relatedProducts = article.data.productIds ? getProductsByIds(article.data.productIds) : [];
// 目次（showToc のある記事）。本文の h2 に、商品の節と FAQ を足す
const toc = article.data.showToc
  ? [
      ...headings.filter((h) => h.depth === 2).map((h) => ({ text: h.text, id: h.slug })),
      ...(relatedProducts.length > 0 ? [{ text: article.data.productFilter ? `シューズ${relatedProducts.filter((p) => p.shoe).length}点の比較` : (article.data.productsHeading ?? '商品の例'), id: 'article-products' }] : []),
      ...(article.data.faqItems && article.data.faqItems.length > 0 ? [{ text: 'よくある質問', id: 'faq-heading' }] : []),
    ]
  : undefined;
// 「次の一歩」ボタンと「読む人から選ぶ」入口。'h:語' は、本文の h2 の先頭が一致する見出しの id に直す（無ければビルドを失敗させる）
const guide = articleGuides[article.id];
const h2s = headings.filter((h) => h.depth === 2);
const resolveHref = (href: string) => {
  if (!href.startsWith('h:')) return href;
  const key = href.slice(2);
  const h = h2s.find((x) => x.text.startsWith(key));
  if (!h) throw new Error(`article-guides: 見出しが見つかりません: ${article.id} / ${key}`);
  return `#${h.slug}`;
};
const nextSteps = guide?.steps.map((l) => ({ label: l.label, href: resolveHref(l.href) }));
const entrances = guide?.entrances
  ? { heading: guide.entrancesHeading ?? '読む人から選ぶ', items: guide.entrances.map((l) => ({ label: l.label, href: resolveHref(l.href) })) }
  : undefined;
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  category={article.data.category}
  pubDate={article.data.pubDate}
  updatedDate={article.data.updatedDate}
  faqItems={article.data.faqItems}
  videos={article.data.videos}
  showAffiliateNotice={relatedProducts.length > 0}
  image={articleImages[article.id]}
  toc={toc}
  nextSteps={nextSteps}
  entrances={entrances}
>
  <Content />

  {relatedProducts.length > 0 && article.data.productFilter && (
    <ShoeCompare heading={article.data.productsHeading ?? '商品の例'} products={relatedProducts} />
  )}

  {relatedProducts.length > 0 && !article.data.productFilter && (
    <div class="not-prose mt-10">
      <h2 id="article-products" class="text-2xl font-bold text-slate-900">{article.data.productsHeading ?? '商品の例'}</h2>
      {article.data.articleType === 'comparison' && relatedProducts.length > 2 && (
        <div class="mt-5">
          <ProductComparisonTable products={relatedProducts} />
        </div>
      )}
      <div class="mt-5">
        <ProductComparisonList products={relatedProducts} />
      </div>
    </div>
  )}

  {article.id === 'find-a-club-near-you' && (
    <PrefectureLinks
      heading="県の名前から探す"
      lead="県を選ぶと、協会の窓口と、市区町村の案内にグラウンドゴルフの記載がある施設が見られます（全国をそろえたものではありません）。"
    />
  )}

  {article.id === 'find-a-class' && (
    <PrefectureLinks
      heading="県の名前から、近くの窓口を探す"
      lead="県を選ぶと、協会の窓口と、市区町村の案内にある施設が見られます。体験教室の問い合わせ先を探す手がかりになります。"
    />
  )}
</ArticleLayout>
