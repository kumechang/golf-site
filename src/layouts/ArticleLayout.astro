---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AffiliateNotice from '../components/AffiliateNotice.astro';
import FAQSection from '../components/FAQSection.astro';
import VideoGallery from '../components/VideoGallery.astro';
import type { VideoItem } from '../components/VideoEmbed.astro';
import { getCategory } from '../data/categories';

interface Props {
  title: string;
  description: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date;
  faqItems?: { question: string; answer: string }[];
  videos?: VideoItem[];
  showAffiliateNotice?: boolean;
  image?: { src: ImageMetadata; alt: string };
  /** 記事の冒頭に出す目次（見出しへ移るボタン）。長い記事向け */
  toc?: { text: string; id: string }[];
  /** 冒頭と末尾に出す「次の一歩」ボタン（最大2つ。1つ目が主） */
  nextSteps?: { label: string; href: string }[];
  /** 長い記事の「読む人から選ぶ」入口（見出しへ移るボタン） */
  entrances?: { heading: string; items: { label: string; href: string }[] };
}

const { title, description, category, pubDate, updatedDate, faqItems, videos, showAffiliateNotice = false, image, toc, nextSteps, entrances } =
  Astro.props as Props;

const cat = getCategory(category);

const breadcrumbItems = [
  { name: 'トップ', href: '/' },
  ...(cat ? [{ name: cat.name, href: `/${cat.slug}/` }] : []),
  { name: title, href: Astro.url.pathname },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Organization',
    name: 'グラウンドゴルフ入門ナビ運営',
  },
  publisher: {
    '@type': 'Organization',
    name: 'グラウンドゴルフ入門ナビ',
  },
};

const faqJsonLd = faqItems
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : undefined;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  </Fragment>

  <Breadcrumb items={breadcrumbItems} />

  <article class="mx-auto max-w-3xl px-4 pb-20 pt-6">
    <header>
      {cat && (
        <a
          href={`/${cat.slug}/`}
          class:list={['inline-block rounded-full px-3 py-1 text-xs font-bold', cat.accent.bg, cat.accent.text]}
        >
          {cat.name}
        </a>
      )}
      <h1 class="mt-3 text-3xl font-bold leading-snug text-slate-900 sm:text-4xl">{title}</h1>
      <p class="mt-3 text-base leading-relaxed text-slate-600">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-600">
        <time datetime={pubDate.toISOString()}>
          公開日: {pubDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {updatedDate && (
          <time datetime={updatedDate.toISOString()}>
            更新日: {updatedDate.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
      </div>
      {showAffiliateNotice && (
        <div class="mt-5">
          <AffiliateNotice />
        </div>
      )}
    </header>

{nextSteps && nextSteps.length > 0 && (
      <nav aria-label="次の一歩" class="not-prose mt-5" data-next-steps>
        
        <ul role="list" class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {nextSteps.map((s, i) => (
            <li>
              <a
                href={s.href}
                class:list={[
                  'inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg px-5 py-2 text-center text-lg font-bold sm:w-auto',
                  i === 0 ? 'bg-green-800 text-white hover:bg-green-900' : 'border-2 border-green-800 bg-white text-green-900 hover:bg-green-50',
                ]}
              >{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {entrances && entrances.items.length > 0 && (
      <nav aria-label={entrances.heading} class="mt-5" data-entrances>
        <p class="text-base font-bold text-slate-900">{entrances.heading}</p>
        <ul role="list" class="mt-2 flex flex-wrap gap-2">
          {entrances.items.map((t) => (
            <li>
              <a href={t.href} class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">{t.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {image && (
      <Image
        src={image.src}
        alt={image.alt}
        width={900}
        height={500}
        class="mt-6 h-auto w-full rounded-2xl object-cover"
      />
    )}

    {toc && toc.length > 0 && (
      <nav aria-label="この記事の内容" class="mt-6" data-article-toc>
        <p class="text-base font-bold text-slate-900">この記事の内容</p>
        <ul role="list" class="mt-2 flex flex-wrap gap-2">
          {toc.map((t) => (
            <li>
              <a href={`#${t.id}`} class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">{t.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {Astro.slots.has('lead') && <div class="mt-8"><slot name="lead" /></div>}

    <div class="prose-article mt-8 text-slate-800">
      <slot />
    </div>

    {Astro.slots.has('after') && <div><slot name="after" /></div>}

{nextSteps && nextSteps.length > 0 && (
      <nav aria-label="次にすること" class="not-prose mt-10" data-next-steps-end>
        <p class="mb-3 text-xl font-bold text-slate-900">次にすること</p>
        <ul role="list" class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          {nextSteps.map((s, i) => (
            <li>
              <a
                href={s.href}
                class:list={[
                  'inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg px-5 py-2 text-center text-lg font-bold sm:w-auto',
                  i === 0 ? 'bg-green-800 text-white hover:bg-green-900' : 'border-2 border-green-800 bg-white text-green-900 hover:bg-green-50',
                ]}
              >{s.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {videos && videos.length > 0 && (
      <VideoGallery
        videos={videos}
        heading="参考動画"
        intro="YouTubeで公開されている動画のうち、この記事の内容に関連するものを載せています。題名と投稿者をもとに載せたもので、動画の内容は、当サイトでは確認していません。内容や考え方は投稿者のもので、当サイトが保証するものではありません。"
      />
    )}

    {faqItems && faqItems.length > 0 && <FAQSection items={faqItems} />}
  </article>
</BaseLayout>
