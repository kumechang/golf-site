---
import { jaDate } from '../data/places';
import { buildPlacesView, type DetailCard } from '../data/places-view';
import { getPrefMap } from '../data/pref-map';
import type { OsmCourseExample } from '../data/osm-course-examples';
import PlaceCard from './PlaceCard.astro';
import PlainPlaceRow from './PlainPlaceRow.astro';
import ListingPlaceRow from './ListingPlaceRow.astro';
import PrefMap from './PrefMap.astro';
import type { VideoItem } from './VideoEmbed.astro';

interface Props {
  prefName: string;
  slug: string;
  verified?: OsmCourseExample[]; // 住所・電話番号を個別に確認した施設（①に合流する）
  videos?: VideoItem[]; // 市区町村の案内に載っていた施設のカードの中に載せる動画（facility に施設名の一部を書く）
  verifiedVideos?: VideoItem[]; // 個別に確認した施設のカードの中に載せる動画
}

const { prefName, slug, verified = [], videos = [], verifiedVideos = [] } = Astro.props as Props;
const view = buildPlacesView(slug, prefName, verified);
const map = getPrefMap(slug);
const link = 'font-bold text-green-800 underline underline-offset-2 hover:text-green-900';
const videoFor = (c: DetailCard) => (c.place ? videos.find((v) => c.name.includes(v.facility!)) : verifiedVideos.find((v) => c.name.includes(v.facility!)));
const targets = new Map(view.chips.filter((c) => c.target).map((c) => [c.code, c.target!]));
// 調べた日。1つの日ならその日、範囲なら「から」でつなぐ。
const surveyed = !view.from ? null : view.from === view.to ? jaDate(view.from) : `${jaDate(view.from)}から${jaDate(view.to!).replace(/^\d{4}年/, '')}`;
const filterable = view.total >= 10;
// スマホで縦に長くならないよう、先頭だけ見せて、残りは「ほかの◯件を見る」にたたむ。
const SHOW_CARDS = 12;
const SHOW_PLAIN = 15;
const SHOW_LISTINGS = 12;
const moreSummary = 'tap-target cursor-pointer px-4 py-2 text-base font-bold text-green-800 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-green-700';
const h3 = 'mt-10 text-xl font-bold leading-snug text-slate-900';
---

<section aria-labelledby="municipal-places-h" id="municipal-places" class="mt-12">
  <div class="prose-article">
    <h2 id="municipal-places-h">{prefName}の市区町村の案内に、グラウンドゴルフの記載がある施設</h2>
  </div>

  {view.total === 0 ? (
    <p class="mt-4 text-base leading-relaxed text-slate-800">
      調べた範囲では、{prefName}内の市区町村の案内にグラウンドゴルフの記載を確認できていません。ない、という意味ではありません。{prefName}グラウンド・ゴルフ協会の窓口や、お住まいの市区町村のスポーツ振興課に尋ねてみてください。
    </p>
  ) : (
    <>
      <p class="mt-4 text-base leading-relaxed text-slate-800">
        {prefName}内の市区町村の案内ページのうち、グラウンドゴルフの記載があったものへのリンクをまとめました。調べた範囲の例で、すべてではありません。{view.municipalityCount}市区町村・{view.total}件です。{surveyed && <><time datetime={view.from!}>{surveyed}</time>に、</>}各市区町村のページで調べたもので、その後に変わっていることがあります。
      </p>
      <p class="mt-3 text-base leading-relaxed text-slate-800">
        確認できたのは「市区町村の案内に記載がある」ところまでです。利用できるか、予約・料金・使える方は、出かける前に市区町村か施設へ確認してください。載っていない市区町村は「ない」ではなく「未確認」です。
      </p>
      <details class="mt-3 rounded-lg border border-slate-300 bg-white">
        <summary class="tap-target cursor-pointer px-4 py-2 text-base font-bold text-green-800 focus-visible:outline focus-visible:outline-4 focus-visible:outline-offset-2 focus-visible:outline-green-700">載っていない市区町村と、リンク先について（くわしい注意）</summary>
        <ul role="list" class="list-disc space-y-2 px-4 pb-4 pl-8 text-base leading-relaxed text-slate-800">
          <li>全国の市区町村をそろえて調べたものではありません。載っていない市区町村は、調べられていないか、記載を確認できなかったところで、施設がない、グラウンドゴルフができない、という意味ではありません。件数の多い少ないも、調べられた範囲の違いによることがあります。</li>
          <li>確認できたのは、「市区町村の案内に、グラウンドゴルフの記載がある」ところまでです。いま利用できるか、誰でも使えるかは、確認できていません。予約が要るか、料金、使える方（その市区町村の方だけ、団体のみ、個人は不可など）、休業や工事は、施設ごとに違うので、出かける前に、市区町村の担当窓口か施設に確認してください。</li>
          <li>リンク先は市区町村のページで、施設の運営者のページとは限りません。{view.cards.length > 0 && '住所・電話番号は、そのページに載っていたものか、個別に調べたものです。電話番号は、施設ではなく担当課などの問い合わせ先のことがあります。'}{view.hasWeb && '一部は、そのページに載っておらず、Web上の公開情報で補ったものです（各カードの出典に書いています）。'}{view.listings.length > 0 && '施設名がないものは、その市区町村の施設の案内ページへのリンクで、どの施設に記載があるかはリンク先でご覧いただけます。'}{view.hasOtherSport && '野球場など、別の競技の名前の施設も、案内にグラウンドゴルフの記載があったものとして載せています。'}</li>
        </ul>
      </details>

      {map && <PrefMap map={map} prefName={prefName} states={view.states} counts={view.counts} targets={targets} />}

      {view.chips.length > 0 && (
        <nav aria-label="市区町村から探す" class="mt-6">
          <p class="text-base font-bold text-slate-900">市区町村から探す</p>
          <ul role="list" class="mt-2 flex flex-wrap gap-2">
            {view.chips.map((c) => (
              <li data-place-chip data-code={c.code}>
                <a href={`#${c.target}`} class="tap-target inline-flex items-center rounded-full border border-slate-400 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">{c.name}<span class="ml-1 font-normal text-slate-700">（{c.count}）</span></a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      {filterable && (
        <div class="mt-6 rounded-xl border border-slate-300 bg-slate-50 p-4" data-place-filter hidden>
          <label for="place-filter" class="block text-base font-bold text-slate-900">市区町村名・施設名で絞り込む</label>
          <div class="mt-2 flex gap-2">
            <input
              id="place-filter"
              type="search"
              autocomplete="off"
              placeholder="例：運動公園"
              class="min-h-[44px] w-full min-w-0 rounded-lg border border-slate-500 bg-white px-3 text-base text-slate-900 placeholder:text-slate-600"
            />
            <button type="button" data-place-clear hidden class="tap-target shrink-0 rounded-lg border border-slate-500 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">クリア</button>
          </div>
          <label class="tap-target mt-2 flex cursor-pointer items-center gap-3 text-base text-slate-900">
            <input type="checkbox" data-place-detail-only class="h-6 w-6 shrink-0 accent-green-800" />
            <span>住所・電話番号のある施設だけ</span>
          </label>
          <p id="place-filter-status" role="status" class="mt-2 min-h-[1.5rem] text-base text-slate-800"></p>
        </div>
      )}

      {view.cards.length > 0 && (
        <section data-place-section aria-labelledby="places-detail-h">
          <h3 id="places-detail-h" class={h3}>住所・電話番号が載っていた施設（{view.cards.length}件）</h3>
          <p class="mt-2 text-base leading-relaxed text-slate-800">
            市区町村のページに載っていた住所・電話番号、または個別に調べたものです。各カードの出典をご覧ください。{view.hasOsm && '一部の施設は、地図の共同編集プロジェクト OpenStreetMap の情報を手がかりにしています。'}営業状況や利用条件は変わることがあるため、訪問前に各施設へご確認ください。
          </p>
          <ul role="list" class="mt-3 grid list-none grid-cols-1 gap-3 pl-0 sm:grid-cols-2">
            {view.cards.slice(0, SHOW_CARDS).map((c) => <PlaceCard c={c} video={videoFor(c)} />)}
          </ul>
          {view.cards.length > SHOW_CARDS && (
            <details class="mt-3 rounded-xl border border-slate-300 bg-white" data-place-more>
              <summary class={moreSummary}>ほかの{view.cards.length - SHOW_CARDS}件を見る</summary>
              <ul role="list" class="grid list-none grid-cols-1 gap-3 p-3 sm:grid-cols-2">
                {view.cards.slice(SHOW_CARDS).map((c) => <PlaceCard c={c} video={videoFor(c)} />)}
              </ul>
            </details>
          )}
          {view.hasOsm && (
            <p class="mt-3 text-sm text-slate-700">
              地図データ出典：<a href="https://www.openstreetmap.org/copyright" rel="nofollow noopener" target="_blank" class={link}>© OpenStreetMap contributors</a>（ODbLライセンス）。
            </p>
          )}
        </section>
      )}

      {view.plain.length > 0 && (
        <section data-place-section aria-labelledby="places-plain-h">
          <h3 id="places-plain-h" class={h3}>住所・電話番号が載っていない施設（{view.plain.length}件）</h3>
          <p class="mt-2 text-base leading-relaxed text-slate-800">市区町村の案内に施設名とグラウンドゴルフの記載があったものです。住所・電話番号は、案内ページでご確認ください。</p>
          <ul role="list" class="mt-3 list-none divide-y divide-slate-200 rounded-xl border border-slate-300 bg-white pl-0">
            {view.plain.slice(0, SHOW_PLAIN).map((r) => <PlainPlaceRow r={r} />)}
          </ul>
          {view.plain.length > SHOW_PLAIN && (
            <details class="mt-3 rounded-xl border border-slate-300 bg-white" data-place-more>
              <summary class={moreSummary}>ほかの{view.plain.length - SHOW_PLAIN}件を見る</summary>
              <ul role="list" class="list-none divide-y divide-slate-200 border-t border-slate-200 pl-0">
                {view.plain.slice(SHOW_PLAIN).map((r) => <PlainPlaceRow r={r} />)}
              </ul>
            </details>
          )}
        </section>
      )}

      {view.listings.length > 0 && (
        <section data-place-section data-listing-section aria-labelledby="places-listing-h">
          <h3 id="places-listing-h" class={h3}>施設名が載っていない案内ページ（{view.listings.length}市区町村）</h3>
          <p class="mt-2 text-base leading-relaxed text-slate-800">市区町村の施設の案内ページのうち、グラウンドゴルフの記載があったものです。どの施設に記載があるかは、リンク先でご覧いただけます。1つの市区町村につき、3件までを載せています。</p>
          <ul role="list" class="mt-3 list-none divide-y divide-slate-200 rounded-xl border border-slate-300 bg-white pl-0">
            {view.listings.slice(0, SHOW_LISTINGS).map((r) => <ListingPlaceRow r={r} />)}
          </ul>
          {view.listings.length > SHOW_LISTINGS && (
            <details class="mt-3 rounded-xl border border-slate-300 bg-white" data-place-more>
              <summary class={moreSummary}>ほかの{view.listings.length - SHOW_LISTINGS}市区町村を見る</summary>
              <ul role="list" class="list-none divide-y divide-slate-200 border-t border-slate-200 pl-0">
                {view.listings.slice(SHOW_LISTINGS).map((r) => <ListingPlaceRow r={r} />)}
              </ul>
            </details>
          )}
        </section>
      )}
    </>
  )}

  <p class="mt-8 text-base leading-relaxed text-slate-800">
    お住まいの市区町村が載っていない場合は、市区町村のスポーツ振興課や社会福祉協議会に、グラウンドゴルフができる場所を尋ねてみてください。上の「{prefName}グラウンド・ゴルフ協会の窓口」も手がかりになります。
  </p>
  <p class="mt-3 text-base leading-relaxed text-slate-800">
    当サイトは、市区町村とは関係のない個人運営の情報サイトです。この一覧は、各市区町村が作ったものではありません。掲載内容に誤りがある場合や、掲載を望まれない場合は、<a class={link} href="/about/">サイトについて／運営者情報</a>のお問い合わせ先までご連絡ください。内容を確認のうえ、対応します。調べ方は<a class={link} href="/about/#places">こちら</a>です。
  </p>
</section>

<script>
  // 絞り込み。市区町村名・施設名に含まれる文字で、表示する行を減らす（ひらがな・カタカナ、全角・半角、大文字・小文字の違いは無視）。
  // 「住所・電話番号のある施設だけ」にもできる。クリアで元に戻る（折りたたみの開閉も、絞り込む前の状態に戻す）。
  // JavaScript が使えないときは、欄ごと出ない。
  const root = document.querySelector<HTMLElement>('#municipal-places');
  const more = [...(root?.querySelectorAll<HTMLDetailsElement>('[data-place-more]') ?? [])];
  const visibleOf = (code: string) => [...(root?.querySelectorAll<HTMLElement>(`[data-place-item][data-code="${code}"]`) ?? [])].filter((el) => !el.hidden);

  const box = document.querySelector<HTMLElement>('[data-place-filter]');
  if (root && box) {
    box.hidden = false;
    const input = box.querySelector<HTMLInputElement>('input[type=search]')!;
    const only = box.querySelector<HTMLInputElement>('[data-place-detail-only]')!;
    const clear = box.querySelector<HTMLButtonElement>('[data-place-clear]')!;
    const status = box.querySelector<HTMLElement>('#place-filter-status')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-place-item]')];
    const sections = [...root.querySelectorAll<HTMLElement>('[data-place-section]')];
    const chips = [...root.querySelectorAll<HTMLElement>('[data-place-chip]')];
    const norm = (s: string) =>
      s.normalize('NFKC').toLowerCase().replace(/\s+/g, '').replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));
    let saved: Map<HTMLDetailsElement, boolean> | null = null;

    const apply = () => {
      const raw = input.value.trim();
      const q = norm(raw);
      const active = q !== '' || only.checked;
      clear.hidden = !active;
      // 絞り込みを始めた時点の開閉を覚えておき、クリアしたときに戻す
      if (active && !saved) saved = new Map(more.map((d) => [d, d.open]));
      let n = 0;
      const codes = new Set<string>();
      for (const li of items) {
        const hit = (q === '' || norm(li.dataset.search ?? '').includes(q)) && (!only.checked || li.dataset.detail === '1');
        li.hidden = !hit;
        if (hit) { n++; if (li.dataset.code) codes.add(li.dataset.code); }
      }
      for (const s of sections) s.hidden = !s.querySelector('[data-place-item]:not([hidden])');
      for (const d of more) {
        const any = Boolean(d.querySelector('[data-place-item]:not([hidden])'));
        d.hidden = active && !any;
        d.open = active ? any : (saved?.get(d) ?? d.open);
      }
      for (const c of chips) c.hidden = active && !codes.has(c.dataset.code ?? '');
      if (!active) { saved = null; status.textContent = ''; return; }
      status.textContent = n > 0
        ? `${n}件（${codes.size}市区町村）が見つかりました。`
        : `${raw ? `「${raw}」` : 'この条件'}に合う記載は見つかりませんでした。載っていないだけで、ないという意味ではありません。`;
    };
    input.addEventListener('input', apply);
    only.addEventListener('change', apply);
    clear.addEventListener('click', () => {
      input.value = '';
      only.checked = false;
      apply();
      input.focus();
    });
  }

  // 目次や地図から移るとき。その市区町村の、いま表示されている最初の項目へ移る（折りたたみの中なら先に開く）。
  const jump = (hash: string): boolean => {
    const m = /^#m-(\d+)$/.exec(decodeURIComponent(hash));
    if (!m) return false;
    const el = visibleOf(m[1])[0] ?? document.getElementById(`m-${m[1]}`);
    if (!el) return false;
    const d = el.closest('details');
    if (d) d.open = true;
    root?.querySelectorAll('.is-target').forEach((x) => x.classList.remove('is-target'));
    el.classList.add('is-target');
    el.setAttribute('tabindex', '-1');
    el.scrollIntoView();
    el.focus({ preventScroll: true });
    return true;
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest('a[href^="#m-"]');
    if (a && jump(a.getAttribute('href')!)) e.preventDefault();
  });
  if (location.hash.startsWith('#m-')) jump(location.hash);
</script>
