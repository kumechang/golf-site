---
import { getPlacesBySlug, jaDate, type PlaceItem } from '../data/places';

interface Props {
  prefName: string;
  slug: string;
}

const { prefName, slug } = Astro.props as Props;
const data = getPlacesBySlug(slug);
const link = 'font-bold text-green-800 underline underline-offset-2 hover:text-green-900';
const mapUrl = (address: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const telHref = (phone: string) => `tel:${phone.replace(/[^0-9+]/g, '')}`;

// 調べた日。1つの日ならその日、範囲なら「から」でつなぐ。
const surveyed = !data.from ? null : data.from === data.to ? jaDate(data.from) : `${jaDate(data.from)}から${jaDate(data.to!).replace(/^\d{4}年/, '')}`;
// 件数の多い県は、市区町村ごとに折りたたむ。2件以下の市区町村は開いたままにする。
const collapse = data.total >= 20;
// 絞り込み欄は、ある程度件数のある県だけ。JavaScript が使えるときだけ表示する（使えないときは何も出さない）。
const filterable = data.total >= 10;
const hasAddress = data.groups.some((g) => g.facilities.some((f) => f.address));
const hasListing = data.groups.some((g) => g.listings.length > 0);
const hasOtherSport = data.groups.some((g) => g.facilities.some((f) => /(野球場|サッカー場|球技場|庭球場|テニス)/.test(f.name ?? '')));
// 一覧ページへのリンクが多い市区町村は、上位3件までにする（番号だけで見分けるリンクが並ぶのを避ける）。
const MAX_LISTINGS = 3;

const label = (it: PlaceItem, g: { listings: PlaceItem[] }) => {
  if (it.kind === 'facility') return it.name!;
  const n = Math.min(g.listings.length, MAX_LISTINGS) > 1 ? `（${g.listings.indexOf(it) + 1}）` : '';
  return `${it.municipality}の施設の案内ページ（グラウンドゴルフの記載あり）${n}`;
};
---

<section aria-labelledby="municipal-places-h" id="municipal-places" class="mt-12 not-prose">
  <h2 id="municipal-places-h" class="text-2xl font-bold leading-snug text-slate-900">{prefName}の市区町村の案内に、グラウンドゴルフの記載がある施設</h2>

  {data.total === 0 ? (
    <p class="mt-4 text-base leading-relaxed text-slate-800">
      調べた範囲では、{prefName}内の市区町村の案内にグラウンドゴルフの記載を確認できていません。ない、という意味ではありません。{prefName}グラウンド・ゴルフ協会の窓口や、お住まいの市区町村のスポーツ振興課に尋ねてみてください。
    </p>
  ) : (
    <>
      <p class="mt-4 text-base leading-relaxed text-slate-800">
        JGGA認定コースとは別に、{prefName}内の市区町村が公開している施設の案内ページのうち、グラウンドゴルフの記載があったものへのリンクをまとめました。{data.municipalityCount}市区町村・{data.total}件です。{surveyed && <><time datetime={data.from!}>{surveyed}</time>に、</>}各市区町村のページで調べたもので、その後に変わっていることがあります。
      </p>
      <p class="mt-6 text-base font-bold text-slate-900">ご覧になる前に</p>
      <ul role="list" class="mt-2 list-disc space-y-2 pl-6 text-base leading-relaxed text-slate-800">
        <li>全国の市区町村をそろえて調べたものではありません。載っていない市区町村は、調べられていないか、記載を確認できなかったところで、施設がない、グラウンドゴルフができない、という意味ではありません。件数の多い少ないも、調べられた範囲の違いによることがあります。</li>
        <li>確認できたのは、「市区町村の案内に、グラウンドゴルフの記載がある」ところまでです。いま利用できるか、誰でも使えるかは、確認できていません。予約が要るか、料金、使える方（その市区町村の方だけ、団体のみ、個人は不可など）、休業や工事は、施設ごとに違うので、出かける前に、市区町村の担当窓口か施設に確認してください。</li>
        <li>リンク先は市区町村のページで、施設の運営者のページとは限りません。{hasAddress && '住所・電話番号は、そのページに載っていたものです。電話番号は、施設ではなく担当課などの問い合わせ先のことがあります。'}{hasListing && '施設名がないものは、その市区町村の施設の案内ページへのリンクで、どの施設に記載があるかはリンク先でご覧いただけます。'}{hasOtherSport && '野球場など、別の競技の名前の施設も、案内にグラウンドゴルフの記載があったものとして載せています。'}</li>
      </ul>

      {filterable && (
        <div class="mt-6" data-place-filter hidden>
          <label for="place-filter" class="block text-base font-bold text-slate-900">市区町村名・施設名で絞り込む</label>
          <div class="mt-2 flex gap-2">
            <input
              id="place-filter"
              type="search"
              autocomplete="off"
              placeholder="例：運動公園"
              class="min-h-[44px] w-full min-w-0 rounded-lg border border-slate-500 bg-white px-3 text-base text-slate-900 placeholder:text-slate-600"
            />
            <button type="button" data-place-clear hidden class="tap-target shrink-0 rounded-lg border border-slate-500 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">クリア</button>
          </div>
          <p id="place-filter-status" role="status" class="mt-2 min-h-[1.5rem] text-base text-slate-700"></p>
        </div>
      )}

      <div class="mt-6">
        {data.groups.map((g) => {
          const listings = g.listings.slice(0, MAX_LISTINGS);
          const items = [...g.facilities, ...listings];
          const rows = (
            <ul role="list" class="mt-1 list-none pl-0">
              {items.map((it) => (
                <li class="border-t border-slate-200 py-3" data-place-item data-search={`${it.municipality} ${it.name ?? ""} ${(it.alsoNames ?? []).join(" ")} ${it.address ?? ""}`}>
                  <span class="block min-w-0 break-words text-base font-bold text-slate-900">{label(it, g)}</span>
                  {it.address && (
                    <dl class="mt-1 space-y-1 text-base text-slate-700">
                      <div class="flex gap-2">
                        <dt class="w-20 shrink-0 text-slate-700">所在地</dt>
                        <dd class="min-w-0 break-words">
                          {it.address}{' '}
                          <a href={mapUrl(it.address)} rel="nofollow noopener" target="_blank" data-gg-outbound="place-map" class="tap-target inline-flex items-center whitespace-nowrap font-bold text-green-800 underline underline-offset-2">地図で見る<span class="sr-only">：{it.name}</span></a><span class="ml-1 text-slate-700">（新しいタブで開きます）</span>
                        </dd>
                      </div>
                      {it.phone && (
                        <div class="flex gap-2">
                          <dt class="w-20 shrink-0 text-slate-700">{it.phoneIsContact ? '問い合わせ先' : '電話番号'}</dt>
                          <dd><a href={telHref(it.phone)} class="tap-target inline-flex items-center px-2 font-bold text-green-800 underline underline-offset-2">{it.phone}<span class="sr-only">（{it.name}）</span></a></dd>
                        </div>
                      )}
                    </dl>
                  )}
                  {it.alsoNames && it.alsoNames.length > 0 && (
                    <span class="mt-1 block text-base text-slate-700">同じ所在地・電話番号の施設：{it.alsoNames.join('、')}</span>
                  )}
                  <span class="mt-1 block">
                    <a
                      href={it.url}
                      rel="nofollow noopener"
                      target="_blank"
                      data-gg-outbound="place-source"
                      class={`tap-target inline-flex items-center text-base ${link}`}
                    >{it.municipality}の案内ページを見る<span class="sr-only">：{label(it, g)}</span></a><span class="ml-1 text-base text-slate-700">（新しいタブで開きます）</span>
                    {it.address && <span class="mt-1 block text-sm text-slate-600">出典：市区町村のページに記載（{jaDate(it.surveyedAt)}取得）</span>}
                  </span>
                </li>
              ))}
            </ul>
          );
          const fold = collapse && items.length >= 3;
          return (
            <div class="border-t border-slate-300" data-place-group data-municipality={g.municipality}>
              <h3 class="!mb-0 !mt-0 py-2 text-lg font-bold text-slate-900">{g.municipality}{collapse ? `（${items.length}件）` : ''}</h3>
              {fold ? (
                <details>
                  <summary class="min-h-[44px] cursor-pointer py-2 text-base font-bold text-green-800 focus-visible:outline-2">{g.municipality}の{items.length}件を表示する</summary>
                  {rows}
                </details>
              ) : rows}
            </div>
          );
        })}
      </div>
    </>
  )}

  <p class="mt-6 text-base leading-relaxed text-slate-800">
    お住まいの市区町村が載っていない場合は、市区町村のスポーツ振興課や社会福祉協議会に、グラウンドゴルフができる場所を尋ねてみてください。上の「{prefName}グラウンド・ゴルフ協会の窓口」も手がかりになります。
  </p>
  <p class="mt-3 text-base leading-relaxed text-slate-800">
    当サイトは、市区町村とは関係のない個人運営の情報サイトです。この一覧は、各市区町村が作ったものではありません。掲載内容に誤りがある場合や、掲載を望まれない場合は、<a class={link} href="/about/">サイトについて／運営者情報</a>のお問い合わせ先までご連絡ください。内容を確認のうえ、対応します。調べ方は<a class={link} href="/about/#places">こちら</a>です。
  </p>
</section>

<script>
  // 絞り込み。市区町村名・施設名に含まれる文字で、表示する行を減らす（ひらがな・カタカナ、全角・半角、大文字・小文字の違いは無視）。
  // 入力を消すと、元の開閉の状態に戻る。
  const box = document.querySelector<HTMLElement>('[data-place-filter]');
  if (box) {
    box.hidden = false;
    const input = box.querySelector<HTMLInputElement>('input')!;
    const clear = box.querySelector<HTMLButtonElement>('[data-place-clear]')!;
    const status = box.querySelector<HTMLElement>('#place-filter-status')!;
    const groups = [...document.querySelectorAll<HTMLElement>('[data-place-group]')];
    const detailsOf = (g: HTMLElement) => g.querySelector<HTMLDetailsElement>('details');
    const initialOpen = new Map(groups.map((g) => [g, detailsOf(g)?.open ?? false]));
    const norm = (s: string) =>
      s.normalize('NFKC').toLowerCase().replace(/\s+/g, '').replace(/[ァ-ヶ]/g, (c) => String.fromCharCode(c.charCodeAt(0) - 0x60));

    const apply = () => {
      const q = norm(input.value);
      clear.hidden = q === '';
      if (!q) {
        for (const g of groups) {
          g.hidden = false;
          g.querySelectorAll<HTMLElement>('[data-place-item]').forEach((li) => (li.hidden = false));
          const d = detailsOf(g);
          if (d) d.open = initialOpen.get(g) ?? false;
        }
        status.textContent = '';
        return;
      }
      let total = 0;
      for (const g of groups) {
        const muniHit = norm(g.dataset.municipality ?? '').includes(q);
        let n = 0;
        g.querySelectorAll<HTMLElement>('[data-place-item]').forEach((li) => {
          const hit = muniHit || norm(li.dataset.search ?? '').includes(q);
          li.hidden = !hit;
          if (hit) n++;
        });
        g.hidden = n === 0;
        total += n;
        const d = detailsOf(g);
        if (n > 0 && d) d.open = true;
      }
      status.textContent = total > 0
        ? `${total}件が見つかりました。`
        : '該当する施設は見つかりませんでした。載っていないだけで、ないという意味ではありません。';
    };
    input.addEventListener('input', apply);
    clear.addEventListener('click', () => {
      input.value = '';
      apply();
      input.focus();
    });
  }
</script>
