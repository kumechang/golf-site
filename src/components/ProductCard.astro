---
import type { Product } from '../data/products';
import AmazonButton from './AmazonButton.astro';

interface Props {
  product: Product;
  rank?: number;
}

const { product, rank } = Astro.props as Props;

const bandLabel: Record<Product['priceBand'], string> = {
  entry: 'エントリー帯',
  standard: 'スタンダード帯',
  premium: '上位モデル帯',
};

const bandColor: Record<Product['priceBand'], string> = {
  entry: 'bg-green-100 text-green-800',
  standard: 'bg-sky-100 text-sky-800',
  premium: 'bg-amber-100 text-amber-900',
};
---

<div class="not-prose rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
  <div class="flex flex-wrap items-center gap-2">
    {rank !== undefined && (
      <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-slate-900 text-sm font-bold text-white">
        {rank}
      </span>
    )}
    <span class:list={['rounded-full px-3 py-1 text-xs font-bold', bandColor[product.priceBand]]}>
      {bandLabel[product.priceBand]}
    </span>
  </div>

  <h3 class="mt-3 text-lg font-bold text-slate-900">{product.name}</h3>
  <p class="mt-1 text-base font-semibold text-slate-800">{product.priceRangeLabel}</p>

  <dl class="mt-4 space-y-2 text-sm text-slate-700">
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 font-semibold text-slate-500">セット内容</dt>
      <dd>{product.setContents}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 font-semibold text-slate-500">素材</dt>
      <dd>{product.material}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 font-semibold text-slate-500">おすすめ</dt>
      <dd>{product.recommendedFor}</dd>
    </div>
  </dl>

  <p class="mt-4 rounded-lg bg-slate-50 p-3 text-sm leading-relaxed text-slate-600">
    <span class="font-semibold text-slate-800">選んだ理由：</span>
    {product.reasonSelected}
  </p>

  <div class="mt-5">
    <AmazonButton product={product} />
  </div>
</div>
