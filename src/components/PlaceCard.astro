---
// 住所・電話番号が載っていた施設のカード（県ページの「施設を探す」節）。スマホで縦に長くならないよう、行を詰めてある。
import { jaDate } from '../data/places';
import { osmCoursesCheckedAt } from '../data/osm-course-examples';
import type { DetailCard } from '../data/places-view';
import VideoEmbed, { type VideoItem } from './VideoEmbed.astro';

interface Props {
  c: DetailCard;
  video?: VideoItem;
}

const { c, video } = Astro.props as Props;
const link = 'font-bold text-green-800 underline underline-offset-2 hover:text-green-900';
const mapUrl = (address: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
const telHref = (phone: string) => `tel:${phone.replace(/[^0-9+]/g, '')}`;
const sourceLine = c.place
  ? `出典：${c.sourceText}（${jaDate(c.place.surveyedAt)}${c.sourceText.startsWith('Web') ? '確認' : '取得'}）`
  : `出典：${c.sourceText}（${osmCoursesCheckedAt}確認）`;
---

<li id={c.anchor} class="list-none rounded-xl border border-slate-300 bg-white p-4 shadow-sm" data-place-item data-detail="1" data-code={c.code ?? undefined} data-search={c.search}>
  <span class="block min-w-0 break-words text-lg font-bold leading-snug text-slate-900">{c.name}</span>
  {c.municipality && <span class="block text-sm text-slate-700">{c.municipality}</span>}
  {c.address && (
    <p class="mt-2 text-base leading-snug text-slate-800">
      {c.address}{' '}<a href={mapUrl(c.address)} rel="nofollow noopener" target="_blank" data-gg-outbound="place-map" class={`tap-target inline-flex items-center whitespace-nowrap text-base ${link}`}>地図で見る<span class="sr-only">：{c.name}</span></a>
    </p>
  )}
  {c.phone && (
    <a href={telHref(c.phone)} class="mt-2 flex min-h-[48px] items-center justify-center whitespace-nowrap rounded-lg bg-green-800 px-4 text-base font-bold text-white hover:bg-green-900">{c.phoneIsContact ? '問い合わせ先に電話する' : '電話をかける'}　{c.phone}<span class="sr-only">（{c.name}）</span></a>
  )}
  {c.phone && c.phoneIsContact && <p class="mt-1 text-sm text-slate-700">施設の番号とは限りません。</p>}
  {c.note && <p class="mt-2 text-sm text-slate-700">備考：{c.note}</p>}
  {c.alsoNames.length > 0 && <p class="mt-2 text-sm text-slate-700">同じ所在地・電話番号の施設：{c.alsoNames.join('、')}</p>}
  {c.url && (
    <p class="mt-1">
      <a href={c.url} rel="nofollow noopener" target="_blank" data-gg-outbound="place-source" class={`tap-target inline-flex items-center text-base ${link}`}>{c.municipality}の案内ページを見る<span class="sr-only">：{c.name}</span></a>
    </p>
  )}
  <p class="text-sm text-slate-700">{sourceLine}</p>
  {video && (
    <div class="mt-3 border-t border-slate-100 pt-3">
      <VideoEmbed video={video} noticeId={`video-${video.id}-notice`} showNotice />
    </div>
  )}
</li>
