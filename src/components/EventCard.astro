---
import { formatDate, formatRange, placeText, type EventItem } from '../data/events';

interface Props {
  event: EventItem;
  today: string;
}

const { event: e, today } = Astro.props as Props;

const place = placeText(e);
const closed = Boolean(e.applicationDeadline && e.applicationDeadline < today);
const levelLabel = e.level === 'national' ? '全国大会' : e.level === 'block' ? 'ブロック大会' : null;
// 曜日の括弧の途中で折り返さない（（木曜\n日）のようになるのを防ぐ）。値は formatDate が作る固定形式。
const nowrap = (t: string) => t.replace(/（([^）]+)）/g, '<span class="whitespace-nowrap">（$1）</span>');
const pill = 'inline-flex items-center rounded-full border px-3 py-1 text-sm font-bold';
---

<li
  class="break-inside-avoid rounded-xl border border-slate-200 bg-white p-4 sm:p-5"
  data-event
  data-end={e.end}
  data-deadline={e.applicationDeadline ?? undefined}
>
  <h3 class="text-lg font-bold leading-snug text-slate-900">{e.name}</h3>

  {(levelLabel || e.applicationDeadline) && (
    <div class="mt-2 flex flex-wrap gap-2">
      {levelLabel && <span class={`${pill} border-indigo-300 bg-indigo-50 text-indigo-900`}>{levelLabel}</span>}
      {e.applicationDeadline && <span class={`${pill} border-amber-400 bg-amber-50 text-amber-900`} data-closed hidden={!closed}>申込受付終了</span>}
    </div>
  )}

  <dl class="mt-3 space-y-2 text-base leading-relaxed text-slate-700">
    <div class="flex gap-3">
      <dt class="w-20 max-w-[40%] shrink-0 font-bold text-slate-900">日程</dt>
      <dd class="min-w-0 break-words text-lg font-bold text-slate-900">
        <time datetime={e.start} set:html={nowrap(e.start === e.end ? formatDate(e.start) : formatRange(e.start, e.end))} />
      </dd>
    </div>
    <div class="flex gap-3">
      <dt class="w-20 max-w-[40%] shrink-0 font-bold text-slate-900">場所</dt>
      <dd class="min-w-0 break-words">
        {place.text}{place.missingVenue && <span class="block text-sm text-slate-600">（会場は掲載元の予定表に記載がありません）</span>}
      </dd>
    </div>
    {e.applicationDeadline && (
      <div class="flex gap-3">
        <dt class="w-20 max-w-[40%] shrink-0 font-bold text-slate-900">申込期限</dt>
        <dd class="min-w-0 break-words">
          <time datetime={e.applicationDeadline} set:html={nowrap(formatDate(e.applicationDeadline))} />
          <span class="mt-1 block text-sm text-slate-600" data-closed hidden={!closed}>掲載元の案内に記された申込期限を過ぎています。</span>
        </dd>
      </div>
    )}
    {e.organizer && (
      <div class="flex gap-3">
        <dt class="w-20 max-w-[40%] shrink-0 font-bold text-slate-900">主催</dt>
        <dd class="min-w-0 break-words">{e.organizer}</dd>
      </div>
    )}
    <div class="flex gap-3">
      <dt class="w-20 max-w-[40%] shrink-0 font-bold text-slate-900">掲載元</dt>
      <dd class="min-w-0 break-words">{e.listedBy}</dd>
    </div>
  </dl>

  {e.publicNote && <p class="mt-3 text-base leading-relaxed text-slate-700">{e.publicNote}</p>}

  <p class="mt-3 text-base leading-relaxed text-slate-800">参加資格・申込は主催者の案内で確認してください。</p>

  <p class="mt-2 flex flex-wrap items-center gap-x-1">
    <a
      href={e.sourceUrl}
      rel="nofollow noopener"
      target="_blank"
      data-gg-outbound="event-source"
      class="tap-target inline-flex items-center text-base font-bold text-green-800 underline underline-offset-2 hover:text-green-900"
    >掲載元のページを見る<span class="sr-only">：{e.name}</span></a><span class="text-base text-slate-700">（新しいタブで開きます）</span>
  </p>
</li>
