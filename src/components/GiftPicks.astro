---
// 贈り物の記事の冒頭に出す「迷ったときの3品」。記事で紹介している商品のうち、Amazonの評価件数が多い3品。
// 件数は products.ts の rating（確認時点の表示）。件数が少ない商品は星の数が不安定なので、選び方は件数だけにしている。
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { productImages } from '../data/product-images';
import AmazonButton from './AmazonButton.astro';

interface Props {
  products: Product[];
  count?: number;
}

const { products, count = 3 } = Astro.props as Props;
const fmt = new Intl.NumberFormat('ja-JP');
const picks = products
  .filter((p) => p.rating)
  .sort((a, b) => b.rating!.count - a.rating!.count)
  .slice(0, count);
const SHORT: Record<string, string> = {
  'hatachi-bh8080-gloves': 'HATACHI ストレッチ手袋 BH8080',
  'hatachi-aero-ball': 'HATACHI エアロボール（2025年）',
  'asics-magnet-gloves': 'asics 磁石付きグローブ',
};
const kind = (p: Product) => (p.tags.includes('ball') ? 'ボール' : p.tags.includes('glove') ? '手袋' : '');
const note = (p: Product) =>
  p.tags.includes('ball') ? 'ボールです。利き手を選びません。' : p.handedness ? '手袋です。右用・左用の別は、商品ページで確認できていません。' : '';
---

{picks.length > 0 && (
  <section class="not-prose rounded-2xl border-2 border-green-800 bg-green-50 p-4 sm:p-5" aria-labelledby="gift-picks-h" id="gift-picks">
    <h2 id="gift-picks-h" class="text-xl font-bold leading-snug text-green-900">迷ったときの{picks.length}品（Amazonの評価件数が多い小物）</h2>
    <p class="mt-2 text-base leading-relaxed text-slate-800">贈る相手の好みが分からないときの目安です。この記事で紹介している小物のうち、Amazonの評価件数が多い{picks.length}品を並べました。</p>
    <ul role="list" class="mt-4 space-y-4">
      {picks.map((p) => (
        <li class="rounded-xl border border-slate-300 bg-white p-4">
          <div class="flex items-center gap-3">
            {productImages[p.asin] && (
              <span class="flex h-20 w-20 shrink-0 items-center justify-center rounded-lg bg-slate-50">
                <Image src={productImages[p.asin]} alt="" width={240} height={240} fit="inside" loading="lazy" class="h-full w-full object-contain mix-blend-multiply" />
              </span>
            )}
            <div class="min-w-0">
              <p class="text-lg font-bold leading-snug text-slate-900">{SHORT[p.id] ?? p.name}</p>
              <p class="mt-1 text-base text-slate-800">参考価格 ¥{fmt.format(p.priceYen)}</p>
              <p class="text-base text-slate-800">Amazonの評価 {p.rating!.stars.toFixed(1)}（{fmt.format(p.rating!.count)}件）</p>
            </div>
          </div>
          {note(p) && <p class="mt-2 text-base leading-relaxed text-slate-800">{note(p)}</p>}
          <div class="mt-3"><AmazonButton product={p} label={`Amazonで見る`} compact /></div>
        </li>
      ))}
    </ul>
  </section>
)}
