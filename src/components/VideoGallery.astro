---
// 参考動画の一覧（記事の末尾・都道府県ページの動画の節）。個々の動画は VideoEmbed。
import VideoEmbed, { type VideoItem } from './VideoEmbed.astro';

interface Props {
  videos: VideoItem[];
  heading: string;
  intro?: string;
  id?: string;
}

const { videos, heading, intro, id = 'videos' } = Astro.props as Props;
const link = 'font-bold text-green-800 underline underline-offset-2 hover:text-green-900';
---

<section aria-labelledby={`${id}-h`} id={id} class="mt-12">
  <h2 id={`${id}-h`} class="text-2xl font-bold leading-snug text-slate-900">{heading}</h2>
  {intro && <p class="mt-3 text-base leading-relaxed text-slate-800">{intro}</p>}
  <p id={`${id}-notice`} class="mt-3 text-base leading-relaxed text-slate-700">
    再生ボタンを押すと、YouTube（Google）のサーバーに接続し、閲覧の情報が送られます。くわしくは<a class={link} href="/privacy-policy/#youtube">プライバシーポリシー</a>をご覧ください。
  </p>
  <ul role="list" class="mt-5 list-none space-y-8 pl-0">
    {videos.map((v) => (
      <li class="list-none">
        <VideoEmbed video={v} noticeId={`${id}-notice`} />
      </li>
    ))}
  </ul>
</section>
