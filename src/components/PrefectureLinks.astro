---
// 県の名前のボタン一覧。クラブ探し・体験教室の探し方・トップで使う。タップしやすい大きさ（44px以上）。
import { getPrefecturesByRegion } from '../data/prefectures';

interface Props {
  id?: string;
  heading: string;
  lead?: string;
  base?: string;
}

const { id = 'pref-list', heading, lead, base = '/community/find-a-club-near-you/' } = Astro.props as Props;
const regions = getPrefecturesByRegion();
---

<section class="not-prose mt-12" aria-labelledby={`${id}-h`} id={id}>
  <h2 id={`${id}-h`} class="text-2xl font-bold text-slate-900">{heading}</h2>
  {lead && <p class="mt-3 max-w-3xl text-base leading-relaxed text-slate-700">{lead}</p>}
  <div class="mt-6 space-y-5">
    {regions.map((r) => (
      <div>
        <h3 class="text-base font-bold text-slate-900">{r.region}</h3>
        <ul role="list" class="mt-2 flex flex-wrap gap-2">
          {r.prefectures.map((p) => (
            <li>
              <a href={`${base}${p.slug}/`} class="tap-target inline-flex items-center rounded-full border border-slate-300 bg-white px-4 text-base font-bold text-slate-800 hover:bg-slate-50">{p.name}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
