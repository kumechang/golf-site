---
import { getCategory } from '../data/categories';

interface Props {
  title: string;
  description: string;
  href: string;
  category: string;
  pubDate: Date;
  updatedDate?: Date; // 公開日より新しければ、更新日も出す
}

const { title, description, href, category, pubDate, updatedDate } = Astro.props as Props;
const fmt = (d: Date) => d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
const showUpdated = Boolean(updatedDate && updatedDate.valueOf() > pubDate.valueOf());
const cat = getCategory(category);
---

<a href={href} class="group block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-shadow hover:shadow-md">
  {cat && (
    <span class:list={['inline-block rounded-full px-2.5 py-0.5 text-xs font-bold', cat.accent.bg, cat.accent.text]}>
      {cat.name}
    </span>
  )}
  <h3 class="mt-2 text-lg font-bold text-slate-900 group-hover:underline">{title}</h3>
  <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-slate-600">{description}</p>
  <time datetime={pubDate.toISOString()} class="mt-3 block text-xs text-slate-600">
    {fmt(pubDate)}
  </time>
  {showUpdated && (
    <time datetime={updatedDate!.toISOString()} class="mt-1 block text-xs text-slate-600">更新日: {fmt(updatedDate!)}</time>
  )}
</a>
